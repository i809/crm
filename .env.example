# ---- Core (required)
KEY=app-uuid
SECRET=app-uuid

# ---- Directus control plane (admin credentials used by onboarding scripts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
DIRECTUS_URL=http://localhost:8055

# ---- Local dev DB (in prod use Supabase)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rubbertrack
DB_USER=postgres
DB_PASSWORD=postgres

# ---- AI providers (at least one needed)
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
OLLAMA_HOST=http://host.docker.internal:11434
CLOUDFLARE_WORKERS_AI_APIKEY=

# ---- BFF
NEXT_PUBLIC_BFF_URL=http://localhost:4000
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
AI_SERVICE_URL=http://ai-service:5000
